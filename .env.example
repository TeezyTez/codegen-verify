# Local secrets. Copy this file to .env and fill only the providers you use.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Reproducible research profile. Generation uses an immutable OpenAI snapshot;
# the critic uses a different provider family to reduce correlated failures.
LLM_PROVIDER=openai
REQUIREMENT_PROVIDER=openai
REQUIREMENT_MODEL=gpt-4.1-2025-04-14
SPEC_PROVIDER=openai
SPEC_MODEL=gpt-4.1-2025-04-14
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-4.1-2025-04-14
CODE_PROVIDER=openai
CODE_MODEL=gpt-4.1-2025-04-14
DIAGNOSIS_PROVIDER=openai
DIAGNOSIS_MODEL=gpt-4.1-2025-04-14
REPAIR_PROVIDER=openai
REPAIR_MODEL=gpt-4.1-2025-04-14
CRITIC_PROVIDER=deepseek
CRITIC_MODEL=deepseek-v4-pro
CRITIC_PROBE_PROVIDER=deepseek
CRITIC_PROBE_MODEL=deepseek-v4-pro

# Fixed research budget. For interactive development, LLM_RETRIES=2 and
# LLM_TEMPERATURE=0.2 are reasonable alternatives.
LLM_TIMEOUT=120
LLM_RETRIES=0
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192
MAX_REPAIR_ROUNDS=3
MAX_SPEC_REVISIONS=1
EVALUATION_MODE=strict
MAX_SPEC_REPAIR_ROUNDS=1

# Agent stages.
ENABLE_STRUCTURED_REQUIREMENTS=1
ENABLE_SPEC_PLANNING=1
ENABLE_FAILURE_DIAGNOSIS=1
ENABLE_MUTATION_GUARD=1
ENABLE_SPEC_CRITIC=1
ALLOW_REFERENCE_IMPLEMENTATION=0

# Critic budget.
CRITIC_TEMPERATURE=0.0
CRITIC_MAX_TOKENS=1800
CRITIC_PROBE_MAX_TOKENS=1200
MAX_CRITIC_PARSE_RETRIES=1
MAX_CRITIC_PROBE_PARSE_RETRIES=2
CRITIC_REVIEW_PASSES=1
MIN_CRITIC_PROBES=3
MAX_CRITIC_PROBES=6
MAX_EXECUTED_CRITIC_PROBES=12
CRITIC_REQUIRE_PRECONDITION_EVIDENCE=1

# Project-local Dafny installation. Keep the solver path empty to use the Z3
# binary bundled and tested with this Dafny release.
DAFNY_PATH=C:\workspace\gencode\codegen-verify\.tools\dafny\4.11.0\Dafny.exe
DAFNY_SOLVER_PATH=

# Optional absolute path overrides.
# DATA_DIR=C:\workspace\gencode\codegen-verify\data
# LOG_DIR=C:\workspace\gencode\codegen-verify\logs
# RUNS_DIR=C:\workspace\gencode\codegen-verify\logs\runs

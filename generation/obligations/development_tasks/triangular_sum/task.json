      "header": "method TriangularSum(n: int) returns (s: int)\n  requires n >= 0\n  ensures s >= 0\n  ensures 2 * s == n * (n + 1)"
    }
  ],
  "reference": {
    "TriangularSum": "s := 0;\nvar i := 0;\nwhile i < n\n  invariant 0 <= i <= n\n  invariant s >= 0\n  invariant 2 * s == i * (i + 1)\n  decreases n - i\n{\n  i := i + 1;\n  s := s + i;\n}"
  },
  "mutants": [
    {
      "id": "multi_defect_seed",
      "violation": "Uses the sum through n-1 instead of n and independently sets s=-1 at n=0.",
      "bodies": {
        "TriangularSum": "s := n * (n - 1) / 2;\nif n == 0 {\n  s := -1;\n}"
      }
    }
  ],

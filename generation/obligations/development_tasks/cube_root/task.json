  "reference": {
    "CubeRoot": "r := 0;\nwhile (r + 1) * (r + 1) * (r + 1) <= n\n  invariant 0 <= r <= n\n  invariant r * r * r <= n\n  decreases n - r\n{\n  r := r + 1;\n}"
  },
